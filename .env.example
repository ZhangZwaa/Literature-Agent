# Required: Zotero Web API credentials
ZOTERO_USER_ID=your_zotero_user_id
ZOTERO_API_KEY=your_zotero_api_key

# Add only the key(s) for providers you actually use.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
